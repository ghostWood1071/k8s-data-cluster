pipeline {
    agent any
    
    environment {
        NS = 'volume-manager'
        RELEASE = 'longhorn'
        VERSION = '1.11.1'
        VALUES = 'k8s-data-services/volume-manager/values.yaml'  // ← Sửa path đúng với repo của bạn
    }
    
    stages {
        stage('Checkout') {
            steps { 
                checkout scm 
            }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    helm repo add longhorn https://charts.longhorn.io || true
                    helm repo update
                    helm upgrade --install ${RELEASE} longhorn/longhorn \
                        -n ${NS} \
                        --version ${VERSION} \
                        -f ${VALUES} \
                        --create-namespace \
                        --wait --timeout 10m
                '''
            }
        }
        
        stage('Verify') {
            steps {
                script {
                    echo "Verifying Longhorn deployment..."
                    sh '''
                        echo "=== Helm Release Status ==="
                        helm status longhorn -n volume-manager --output table
                        
                        echo ""
                        echo "=== Longhorn Pods ==="
                        kubectl get pods -n volume-manager -o wide
                        
                        echo ""
                        echo "===Longhorn UI Service ==="
                        kubectl get svc -n volume-manager -l app=longhorn-ui
                        
                        echo ""
                        echo "Longhorn is running! (Verification complete)"
                    '''
                }
            }
        }
    }
    
    post {
        success { 
            echo "Siuuuu" 
        }
        failure { 
            echo "Lỗi rồi :(" 
        }
    }
}