pipeline {
    agent any
    
    environment {
        NS = 'volume-manager'
        RELEASE = 'longhorn'
        VERSION = '1.11.1'
        VALUES = 'values.yaml'
    }
    
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        
        stage('Deploy') {
            steps {
                sh '''
                    helm repo add longhorn https://charts.longhorn.io || true
                    helm repo update
                    helm upgrade --install ${RELEASE} longhorn/longhorn \
                        -n ${NS} \
                        --version ${VERSION} \
                        -f ${VALUES} \
                        --create-namespace \
                        --wait --timeout 10m
                '''
            }
        }
        
        stage('Verify') {
            steps {
                sh "kubectl wait --for=condition=ready pod -l app=longhorn -n ${NS} --timeout=180s"
                sh "helm status ${RELEASE} -n ${NS}"
            }
        }
    }
    
    post {
        success { echo "✅ Longhorn deployed!" }
        failure { echo "❌ Deploy failed!" }
    }
}